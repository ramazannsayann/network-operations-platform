# Only needed to run the backend on the host (uv run uvicorn ... / celery / alembic)
# against the db and redis containers. Copy to backend/.env; it is git-ignored.
# Use the same POSTGRES_PASSWORD as deploy/.env.
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=netops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=netops

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
