# Configuration for deploy/docker-compose.yml.
# Copy to deploy/.env (`make up` does this for you and generates a random DB password).
# deploy/.env is git-ignored: never commit real credentials.

# --- Application -------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# json (one object per line, for log shipping) or console (human-readable)
LOG_FORMAT=json

# --- PostgreSQL / TimescaleDB ------------------------------------------------
# Used by both the db container and the backend services.
# The password is applied when the db volume is first created; changing it later
# also requires changing it inside PostgreSQL (ALTER ROLE ... PASSWORD ...).
POSTGRES_USER=netops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=netops

# --- Credential encryption (ADR-0004) -----------------------------------------
# Fernet key(s) that encrypt stored device credentials; `make up` generates one.
# Keep a copy outside the database backups: without it stored credentials are lost.
# Several comma-separated keys enable rotation (the first one encrypts).
CREDENTIALS_KEY=change-me

# --- Authentication (M7, ADR-0008) --------------------------------------------
# Signs the access tokens (HS256); `make env` generates one. At least 32 random
# characters; comma-separated keys rotate (the first signs, all verify). Changing it
# signs everyone out (their access tokens stop verifying within 15 minutes).
AUTH_SIGNING_KEY=change-me
# Roles that must use TOTP (comma-separated; empty makes MFA optional for everyone).
AUTH_MFA_REQUIRED_ROLES=admin,operator
# The refresh cookie's Secure flag: auto (when the request came over HTTPS), true, false.
AUTH_COOKIE_SECURE=auto

# --- Fake lab (make fakelab-up) ----------------------------------------------
# Password of the fake devices (lab/fakelab/topology.yaml); `make fakelab-up` generates it.
# FAKELAB_USERNAME=netops-ro
# FAKELAB_PASSWORD=

# --- Celery ------------------------------------------------------------------
CELERY_CONCURRENCY=2

# --- Configuration management (M4, ADR-0007) ----------------------------------
# When every managed device's configuration is backed up: cron (minute hour day month
# weekday), UTC. Configurations live in the config-repo volume (back it up!).
CONFIG_BACKUP_SCHEDULE=30 2 * * *
# After the last %SYS-5-CONFIG_I / CFGLOG message of a device, wait this long before
# backing it up (one backup per editing session).
CONFIG_CHANGE_DEBOUNCE_SECONDS=30
# The account M5 will push changes with (its changes count as origin "platform").
# PLATFORM_WRITE_USERNAME=

# --- Syslog receiver (events service) -----------------------------------------
# Host side of UDP 514. Devices need the receiver at their real source address: on a
# Linux host use host networking (ADR-0007); 127.0.0.1 keeps it local meanwhile.
SYSLOG_BIND=127.0.0.1
SYSLOG_HOST_PORT=5514

# --- Published ports (host side) ---------------------------------------------
# Everything binds to 127.0.0.1. Set WEB_BIND=0.0.0.0 to reach the UI from other machines.
WEB_BIND=127.0.0.1
WEB_PORT=8080
API_HOST_PORT=8000
# 5433, not 5432, so it does not clash with a PostgreSQL installed on the host.
DB_HOST_PORT=5433
REDIS_HOST_PORT=6379
