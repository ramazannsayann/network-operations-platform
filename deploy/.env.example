# Configuration for deploy/docker-compose.yml.
# Copy to deploy/.env (`make up` does this for you and generates a random DB password).
# deploy/.env is git-ignored: never commit real credentials.

# --- Application -------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# json (one object per line, for log shipping) or console (human-readable)
LOG_FORMAT=json

# --- PostgreSQL / TimescaleDB ------------------------------------------------
# Used by both the db container and the backend services.
# The password is applied when the db volume is first created; changing it later
# also requires changing it inside PostgreSQL (ALTER ROLE ... PASSWORD ...).
POSTGRES_USER=netops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=netops

# --- Credential encryption (ADR-0004) -----------------------------------------
# Fernet key(s) that encrypt stored device credentials; `make up` generates one.
# Keep a copy outside the database backups: without it stored credentials are lost.
# Several comma-separated keys enable rotation (the first one encrypts).
CREDENTIALS_KEY=change-me

# --- Fake lab (make fakelab-up) ----------------------------------------------
# Password of the fake devices (lab/fakelab/topology.yaml); `make fakelab-up` generates it.
# FAKELAB_USERNAME=netops-ro
# FAKELAB_PASSWORD=

# --- Celery ------------------------------------------------------------------
CELERY_CONCURRENCY=2

# --- Published ports (host side) ---------------------------------------------
# Everything binds to 127.0.0.1. Set WEB_BIND=0.0.0.0 to reach the UI from other machines.
WEB_BIND=127.0.0.1
WEB_PORT=8080
API_HOST_PORT=8000
# 5433, not 5432, so it does not clash with a PostgreSQL installed on the host.
DB_HOST_PORT=5433
REDIS_HOST_PORT=6379
